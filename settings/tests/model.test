# The model: resolution (pinned, then the named preset, then the shipped
# default), the four edits of a flat table, and the ssh rows, each held to
# the machine-write contract's bar that one changed key is one changed
# line. A row that is added or removed is one added or removed block, and
# every byte around it stands. The schema behind the resolution is what
# the terminal states: these tests open the model against a real binary,
# the way the window does, and skip where a checkout has none to ask.

package require tcltest 2.5
namespace import ::tcltest::*

source [file join [file dirname [info script]] helpers.tcl]
source [file join $::libdir model.tcl]
need_binary

set ::configdir [file join [temporaryDirectory] model-[pid]]
set ::configpath [file join $::configdir config.toml]

# Put $text on disk and point the model at it. Returns the text, so a
# test can compare the file's bytes before and after an edit.
proc with_config {text} {
    file mkdir $::configdir
    ::tomledit::atomic_write $::configpath $text
    ::rcsettings::model::init $::configpath
    return $text
}

proc without_config {} {
    file delete -force $::configdir
    ::rcsettings::model::init $::configpath
}

proc on_disk {} {
    return [::tomledit::read_file $::configpath]
}

# Every screen key the schema knows, as the user currently sees it. What
# pin_overrides must leave unchanged.
proc screen_look {} {
    set out {}
    foreach key [::rcsettings::model::table_keys screen] {
        if {$key eq "name"} { continue }
        lappend out $key [::rcsettings::model::effective screen $key]
    }
    return $out
}

test schema-1.1 {defaults are raw TOML, presets in declaration order} -constraints realBinary -body {
    list [::rcsettings::model::shipped screen bloom] \
        [lrange [::rcsettings::model::preset_names screen] 0 2] \
        [::rcsettings::model::preset_names chassis]
} -result {0.6 {{Default Amber} {Monochrome Green} {Deep Blue}} {Annunciator {Slide Rule} Switchboard}}

test schema-1.2 {fonts are catalogue key and display name} -constraints realBinary -body {
    lindex [::rcsettings::model::fonts] 6
} -result {COZETTE_SCALED Cozette}

test schema-1.3 {the value lists} -constraints realBinary -body {
    list [::rcsettings::model::enum shell] \
        [::rcsettings::model::enum channel_display]
} -result {{annunciator slide-rule switchboard} {led tape}}

test schema-1.4 {an unknown table or preset is an error, never a guess} -constraints realBinary -body {
    list [catch {::rcsettings::model::preset screen Vintage}] \
        [catch {::rcsettings::model::shipped screen no_such_key}]
} -result {1 1}

test effective-2.1 {pinned, then the named preset, then the default} -constraints realBinary -setup {
    with_config $::fixture
} -body {
    list [::rcsettings::model::effective screen bloom] \
        [::rcsettings::model::effective screen font_color] \
        [::rcsettings::model::effective general led_characters]
} -result {0.9 #7fb4ff 12}

test effective-2.2 {the base of an unpinned key is the preset's value} -constraints realBinary -setup {
    with_config $::fixture
} -body {
    list [::rcsettings::model::base screen ambient_light] \
        [::rcsettings::model::pinned screen bloom] \
        [::rcsettings::model::pinned screen font_color] \
        [::rcsettings::model::preset_name screen]
} -result {0.0 1 0 {Deep Blue}}

test effective-2.3 {a name matching no built-in falls back to the default} -constraints realBinary -setup {
    with_config "\[screen\]\nname = \"my workshop\"\n"
} -body {
    list [::rcsettings::model::effective screen bloom] \
        [::rcsettings::model::effective screen font_name]
} -result {0.6 TERMINESS_SCALED}

test effective-2.4 {an unnamed table resolves against the shipped default} -constraints realBinary -setup {
    without_config
} -body {
    list [::rcsettings::model::preset_name screen] \
        [::rcsettings::model::effective screen bloom] \
        [::rcsettings::model::effective chassis shell]
} -result {{Default Amber} 0.6 annunciator}

test set-3.1 {an edit changes one line and no other byte} -constraints realBinary -setup {
    set before [with_config $::fixture]
} -body {
    ::rcsettings::model::set_value screen bloom 0.4
    list [surgery $before [on_disk]] [::rcsettings::model::effective screen bloom]
} -result {{{{bloom = 0.9}} {{bloom = 0.4}}} 0.4}

test set-3.2 {a value equal to the base is written by removing the key} -constraints realBinary -setup {
    set before [with_config $::fixture]
} -body {
    ::rcsettings::model::set_value screen bloom 0.6
    list [surgery $before [on_disk]] \
        [::rcsettings::model::pinned screen bloom] \
        [::rcsettings::model::effective screen bloom]
} -result {{{{bloom = 0.9}} {}} 0 0.6}

test set-3.3 {the base is the preset's value, not the shipped default} -constraints realBinary -setup {
    with_config $::fixture
} -body {
    # Deep Blue turns the ambient light off; the shipped default is 0.3,
    # so asking for 0.3 is a pin, not a fall-back.
    ::rcsettings::model::set_value screen ambient_light 0.3
    list [::rcsettings::model::pinned screen ambient_light] \
        [::tomledit::get [on_disk] screen.ambient_light]
} -result {1 0.3}

test set-3.4 {a key the file does not have yet costs one added line} -constraints realBinary -setup {
    set before [with_config $::fixture]
} -body {
    ::rcsettings::model::set_value screen font_name IOSEVKA
    surgery $before [on_disk]
} -result {{} {{font_name = "IOSEVKA"}}}

test set-3.5 {a value is formatted after the type of its default} -constraints realBinary -setup {
    with_config $::fixture
} -body {
    ::rcsettings::model::set_value screen font_name IOSEVKA
    ::rcsettings::model::set_value general led_characters 20
    ::rcsettings::model::set_value screen blinking_cursor 1
    ::rcsettings::model::set_value general font_scaling 2
    set text [on_disk]
    lmap {table key} {screen font_name general led_characters
                      screen blinking_cursor general font_scaling} {
        ::tomledit::get $text $table.$key
    }
} -result {{"IOSEVKA"} 20 true 2.0}

test set-3.6 {an absent file is an empty document to edit} -constraints realBinary -setup {
    without_config
} -body {
    ::rcsettings::model::set_value chassis frame_size 0.6
    on_disk
} -result "\[chassis\]\nframe_size = 0.6\n"

test set-3.7 {the file is re-read before each write} -constraints realBinary -setup {
    with_config $::fixture
} -body {
    # Another writer lands between the model's load and its next edit.
    ::tomledit::atomic_write $::configpath \
        [::tomledit::put $::fixture general.led_characters 20]
    ::rcsettings::model::set_value screen bloom 0.4
    list [::tomledit::get [on_disk] general.led_characters] \
        [::tomledit::get [on_disk] screen.bloom]
} -result {20 0.4}

test reset-4.1 {reset unpins, leaving the preset's value showing} -constraints realBinary -setup {
    set before [with_config $::fixture]
} -body {
    ::rcsettings::model::reset screen bloom
    list [surgery $before [on_disk]] [::rcsettings::model::effective screen bloom]
} -result {{{{bloom = 0.9}} {}} 0.6}

test switch-5.1 {switching presets drops this table's overrides only} -constraints realBinary -setup {
    with_config $::fixture
} -body {
    ::rcsettings::model::switch_preset screen E-Ink
    list [on_disk] [::rcsettings::model::effective screen bloom]
} -result "{# The workshop terminal.
# Do not let the bloom get away from you again.

\[general\]
font_scaling   =   1.2\t# bigger type, fewer rows
effects_frame_skip = 2


# the look
\[screen\]
name = \"E-Ink\"
mystery_key = \"kept\"

\[dotfiles_tool\]
generated_at = \"2026-08-01\"
} 0.0"

test switch-5.2 {naming the shipped preset removes the name key} -constraints realBinary -setup {
    with_config $::fixture
} -body {
    ::rcsettings::model::switch_preset screen {Default Amber}
    list [::rcsettings::model::pinned screen name] \
        [::rcsettings::model::preset_name screen] \
        [::rcsettings::model::effective screen bloom] \
        [::tomledit::get [on_disk] screen.mystery_key]
} -result {0 {Default Amber} 0.6 {"kept"}}

test switch-5.3 {switching a table the file has no header for} -constraints realBinary -setup {
    without_config
} -body {
    ::rcsettings::model::switch_preset chassis Switchboard
    list [on_disk] [::rcsettings::model::effective chassis channel_display]
} -result "{\[chassis\]\nname = \"Switchboard\"\n} tape"

test pin-6.1 {pinning overrides keeps every visible value where it was} -constraints realBinary -setup {
    with_config $::fixture
} -body {
    set was [screen_look]
    ::rcsettings::model::pin_overrides screen E-Ink
    list [::rcsettings::model::preset_name screen] \
        [string equal $was [screen_look]] \
        [::rcsettings::model::pinned screen font_color]
} -result {E-Ink 1 1}

test pin-6.2 {a pinned key the new base already gives is unpinned} -constraints realBinary -setup {
    with_config "\[screen\]\nname = \"Deep Blue\"\njitter = 0.2\nbloom = 0.9\n"
} -body {
    set was [screen_look]
    ::rcsettings::model::pin_overrides screen {Default Amber}
    list [string equal $was [screen_look]] \
        [::rcsettings::model::pinned screen jitter] \
        [::rcsettings::model::pinned screen bloom] \
        [::rcsettings::model::pinned screen name]
} -result {1 0 1 0}

test pin-6.3 {pinning against a name no preset answers to} -constraints realBinary -setup {
    with_config $::fixture
} -body {
    set was [screen_look]
    ::rcsettings::model::pin_overrides screen {my workshop}
    list [::rcsettings::model::preset_name screen] [string equal $was [screen_look]]
} -result {{my workshop} 1}

# The rows as the tab draws them: the host of each, and which one the
# file's `default` puts the check on.
proc ssh_view {} {
    set out {}
    foreach row [::rcsettings::model::ssh_hosts] { lappend out [dict get $row host] }
    return [list $out [::rcsettings::model::ssh_default]]
}

test ssh-8.1 {rows resolve their fields against the row defaults} -constraints realBinary -setup {
    with_config $::sshfixture
} -body {
    list [ssh_view] [lindex [::rcsettings::model::ssh_hosts] 1]
} -result {{{vault relay spare} vault} {host relay user {} port 2222 key {}}}

test ssh-8.2 {a file with no rows has none, and starts on localhost} -constraints realBinary -setup {
    with_config $::fixture
} -body {
    ssh_view
} -result {{} {}}

test ssh-8.3 {a default naming no row is what it is; the tab reads it} -constraints realBinary -setup {
    with_config "\[ssh\]\ndefault = \"gone\"\n"
} -body {
    ssh_view
} -result {{} gone}

test ssh-9.1 {a field equal to the row default is written by removing it} -constraints realBinary -setup {
    set before [with_config $::sshfixture]
} -body {
    ::rcsettings::model::set_ssh_host 1 port 22
    list [surgery $before [on_disk]] \
        [dict get [lindex [::rcsettings::model::ssh_hosts] 1] port]
} -result {{{{port = 2222}} {}} 22}

test ssh-9.2 {a field away from its default is one changed line} -constraints realBinary -setup {
    set before [with_config $::sshfixture]
} -body {
    ::rcsettings::model::set_ssh_host 2 port 2022
    list [surgery $before [on_disk]] \
        [lmap row [::rcsettings::model::ssh_hosts] {dict get $row port}]
} -result {{{} {{port = 2022}}} {22 2222 2022}}

test ssh-9.3 {host is written even when it is the row default's own value} -constraints realBinary -setup {
    with_config $::sshfixture
} -body {
    ::rcsettings::model::set_ssh_host 2 host ""
    list [::tomledit::count [on_disk] ssh.host] \
        [lmap row [::rcsettings::model::ssh_hosts] {dict get $row host}]
} -result {3 {vault relay {}}}

test ssh-9.4 {a field is formatted after the type of its row default} -constraints realBinary -setup {
    with_config $::sshfixture
} -body {
    ::rcsettings::model::set_ssh_host 0 port 2222
    ::rcsettings::model::set_ssh_host 0 key {~/.ssh/id_ed25519}
    set text [on_disk]
    list [::tomledit::get $text {ssh.host[0].port}] \
        [::tomledit::get $text {ssh.host[0].key}]
} -result {2222 {"~/.ssh/id_ed25519"}}

test ssh-9.5 {an unknown key inside a row is round-tripped} -constraints realBinary -setup {
    with_config $::sshfixture
} -body {
    ::rcsettings::model::set_ssh_host 0 user "someone"
    ::tomledit::plain [::tomledit::get [on_disk] {ssh.host[0].note}]
} -result {unknown to this tool}

test ssh-10.1 {renaming the checked row takes the check with it} -constraints realBinary -setup {
    set before [with_config $::sshfixture]
} -body {
    ::rcsettings::model::set_ssh_host 0 host "vault.example.com"
    list [surgery $before [on_disk]] [ssh_view]
} -result {{{{default = "vault"} {odd_key = "kept"} {} {# the vault, behind the door} {[[ssh.host]]} {host = "vault"}} {{default = "vault.example.com"} {odd_key = "kept"} {} {# the vault, behind the door} {[[ssh.host]]} {host = "vault.example.com"}}} {{vault.example.com relay spare} vault.example.com}}

test ssh-10.2 {renaming a row the check is not on leaves the check} -constraints realBinary -setup {
    with_config $::sshfixture
} -body {
    ::rcsettings::model::set_ssh_host 1 host "relay.example.com"
    ssh_view
} -result {{vault relay.example.com spare} vault}

test ssh-11.1 {checking a row writes its host as the default} -constraints realBinary -setup {
    set before [with_config $::sshfixture]
} -body {
    ::rcsettings::model::set_ssh_default "spare"
    list [surgery $before [on_disk]] [::rcsettings::model::ssh_default]
} -result {{{{default = "vault"}} {{default = "spare"}}} spare}

test ssh-11.2 {checking localhost removes the key rather than emptying it} -constraints realBinary -setup {
    set before [with_config $::sshfixture]
} -body {
    ::rcsettings::model::set_ssh_default ""
    list [surgery $before [on_disk]] \
        [dict exists [::tomledit::parse [on_disk]] tables ssh default] \
        [::rcsettings::model::ssh_default]
} -result {{{{default = "vault"}} {}} 0 {}}

test ssh-11.3 {a default for rows that have no table above them} -constraints realBinary -setup {
    with_config "\[\[ssh.host\]\]\nhost = \"a\"\n"
} -body {
    # An explicit `[ssh]` after its own rows is not a document the
    # terminal's parser reads back, so the table goes above them.
    ::rcsettings::model::set_ssh_default "a"
    on_disk
} -result "\[ssh\]\ndefault = \"a\"\n\n\[\[ssh.host\]\]\nhost = \"a\"\n"

test ssh-12.1 {a new row carries its host and nothing else} -constraints realBinary -setup {
    set before [with_config $::sshfixture]
} -body {
    ::rcsettings::model::add_ssh_host
    list [surgery $before [on_disk]] [lindex [::rcsettings::model::ssh_hosts] 3]
} -result {{{} {{[[ssh.host]]} {host = ""} {}}} {host {} user {} port 22 key {}}}

test ssh-12.2 {the first row of a file that has none} -constraints realBinary -setup {
    without_config
} -body {
    ::rcsettings::model::add_ssh_host
    ::rcsettings::model::set_ssh_host 0 host "vault"
    ::rcsettings::model::set_ssh_default "vault"
    on_disk
} -result "\[ssh\]\ndefault = \"vault\"\n\n\[\[ssh.host\]\]\nhost = \"vault\"\n"

test ssh-13.1 {removing a row leaves every other row's bytes} -constraints realBinary -setup {
    set before [with_config $::sshfixture]
} -body {
    ::rcsettings::model::remove_ssh_host 1
    list [surgery $before [on_disk]] [ssh_view]
} -result {{{{host = "relay"} {port = 2222} {} {[[ssh.host]]}} {}} {{vault spare} vault}}

test ssh-13.2 {removing the checked row unchecks it} -constraints realBinary -setup {
    with_config $::sshfixture
} -body {
    ::rcsettings::model::remove_ssh_host 0
    list [ssh_view] \
        [dict exists [::tomledit::parse [on_disk]] tables ssh default]
} -result {{{relay spare} {}} 0}

test ssh-13.3 {a row of the same name still answering keeps the check} -constraints realBinary -setup {
    with_config "\[ssh\]\ndefault = \"a\"\n\n\[\[ssh.host\]\]\nhost = \"a\"\n\n\[\[ssh.host\]\]\nhost = \"a\"\nport = 2222\n"
} -body {
    ::rcsettings::model::remove_ssh_host 0
    ssh_view
} -result {a a}

test ssh-14.1 {the file is re-read before an ssh write too} -constraints realBinary -setup {
    with_config $::sshfixture
} -body {
    ::tomledit::atomic_write $::configpath \
        [::tomledit::put $::sshfixture general.led_characters 20]
    ::rcsettings::model::set_ssh_host 1 port 2200
    list [::tomledit::get [on_disk] general.led_characters] \
        [lindex [::rcsettings::model::ssh_hosts] 1]
} -result {20 {host relay user {} port 2200 key {}}}

test guard-15.1 {an edit is refused whole on a file outside the subset} -constraints realBinary -setup {
    with_config "\[general\]\nbanner = \"\"\"\nwelcome\n\[screen\]\n\"\"\"\n"
} -body {
    set code [catch {::rcsettings::model::set_value screen bloom 0.4} err]
    # The refusal must leave the file's bytes exactly as they were: the
    # guard exists so nothing lands inside the string's body.
    list $code [string match "*cannot edit safely*" $err] \
        [string equal [on_disk] \
            "\[general\]\nbanner = \"\"\"\nwelcome\n\[screen\]\n\"\"\"\n"]
} -result {1 1 1}

test guard-15.2 {reading an unsafe file still works} -constraints realBinary -setup {
    with_config "\[general\]\nfont_scaling = 1.5\npoint = { x = 1 }\n"
} -body {
    ::rcsettings::model::effective general font_scaling
} -result 1.5

# The bindings table is written in Rio's syntax, a multi-line array of
# inline tables, the one shape of that kind the editor admits. A file
# carrying it stays editable, and the block stands byte for byte.
set ::bindings_block "\[bindings\]\nkeys = \[\n  { key = \"b\", with = \"ctrl | shift\", action = \"fold_bank\" },\n  { key = \"c\", with = \"ctrl | shift\", action = \"pass\" },\n\]\n"

test guard-15.3 {a file carrying a bindings block is edited beside it} -constraints realBinary -setup {
    set before [with_config "\[general\]\nfont_scaling = 1.5\n\n$::bindings_block"]
} -body {
    ::rcsettings::model::set_value general font_scaling 1.2
    list [surgery $before [on_disk]] \
        [string equal [string range [on_disk] end-[expr {[string length $::bindings_block] - 1}] end] \
            $::bindings_block]
} -result {{{{font_scaling = 1.5}} {{font_scaling = 1.2}}} 1}

test guard-15.4 {a binding row is addressable through the editor the window uses} -constraints realBinary -setup {
    set before [with_config "\[general\]\nfont_scaling = 1.5\n\n$::bindings_block"]
} -body {
    list [::tomledit::count [on_disk] bindings.keys] \
        [::tomledit::plain [::tomledit::get [on_disk] {bindings.keys[1].action}]] \
        [surgery $before [::tomledit::put [on_disk] {bindings.keys[1].action} {"swallow"}]]
} -result {2 pass {{{  { key = "c", with = "ctrl | shift", action = "pass" },}} {{  { key = "c", with = "ctrl | shift", action = "swallow" },}}}}

test path-7.1 {the platform's default config path} -body {
    set saved [array get ::env XDG_CONFIG_HOME]
    set ::env(XDG_CONFIG_HOME) [file join / xdg]
    set p [::rcsettings::model::default_config_path]
    unset ::env(XDG_CONFIG_HOME)
    array set ::env $saved
    expr {$::tcl_platform(platform) eq "unix" && $::tcl_platform(os) ne "Darwin"
          ? $p eq [file join / xdg robco-term config.toml]
          : 1}
} -result 1

file delete -force $::configdir
::tcltest::cleanupTests
