# The form's layout against the schema in model.tcl.
#
# The rest of the suite tests how a value is resolved and written. This file
# tests whether the window shows every key the schema carries: a key added
# to the schema and never given a row is invisible in the settings window
# and unreachable except by hand-editing, and nothing else in this
# repository would notice. (The schema is the binary's own dump, read when
# the model opens, so the chain window-to-schema-to-binary closes.) The SSH
# tab is held to the same bar further down, against the fields of an
# `[[ssh.host]]` row and the keys of `[ssh]`.
#
# These tests need Tk, ui/form.tcl requiring it at source time; the toplevel
# is withdrawn on the way past so a suite run on a live display flashes
# nothing.

package require tcltest 2.5
namespace import ::tcltest::*

source [file join [file dirname [info script]] helpers.tcl]
source [file join $::libdir model.tcl]
need_binary

set ::uidir [file normalize [file join [file dirname [info script]] .. ui]]

testConstraint tk [expr {![catch {package require Tk}]}]
if {[testConstraint tk]} {
    wm withdraw .
    source [file join $::uidir form.tcl]
    source [file join $::uidir ssh_page.tcl]
}

# The keys the form deliberately does not show, and why. The first four are
# what docs/config.md marks as read by nothing in this build; `name` is the
# preset picker at the head of the page rather than a row of its own.
set ::unshown {
    general {show_menubar use_custom_command custom_command}
    screen  {blinking_cursor name}
    chassis {name}
    critters {}
    serial   {}
}

# A key written table.key belongs to that table, and a note row names no key.
proc layout_rows {} {
    set out {}
    foreach table {general screen chassis critters serial} {
        foreach {title rows} [dict get $::rcsettings::ui::form::Layout $table] {
            foreach {key kind label arg} $rows {
                set owner $table
                regexp {^(\w+)\.(.+)$} $key - owner key
                if {$kind ne "note"} { lappend out [list $owner $key $kind $arg] }
            }
        }
    }
    return $out
}

proc layout_keys {table} {
    lmap row [layout_rows] { if {[lindex $row 0] eq $table} { lindex $row 1 } else continue }
}

test layout-1.1 {every key the schema carries is either a row or a named omission} -constraints {
    tk realBinary
} -body {
    set missing {}
    foreach table {general screen chassis critters serial} {
        set shown [layout_keys $table]
        foreach key [::rcsettings::model::table_keys $table] {
            if {$key in $shown} { continue }
            if {$key in [dict get $::unshown $table]} { continue }
            lappend missing $table.$key
        }
    }
    set missing
} -result {}

test layout-1.2 {no row names a key the schema does not have} -constraints {
    tk realBinary
} -body {
    set unknown {}
    foreach row [layout_rows] {
        lassign $row table key
        if {![::rcsettings::model::has_default $table $key]} {
            lappend unknown $table.$key
        }
    }
    set unknown
} -result {}

test layout-1.3 {a row that is omitted is omitted on purpose} -constraints {
    tk realBinary
} -body {
    # The other direction of 1.1: an omission that no longer names a real key
    # is a stale exemption, and would hide the next key to take that name.
    set stale {}
    dict for {table keys} $::unshown {
        foreach key $keys {
            if {![::rcsettings::model::has_default $table $key]} {
                lappend stale $table.$key
            }
        }
    }
    set stale
} -result {}

test layout-1.4 {a page note names a page that exists} -constraints {
    tk realBinary
} -body {
    # The sibling of 1.3: a note keyed to a table the form no longer builds
    # is drawn nowhere, and says nothing while looking like it does.
    set stale {}
    dict for {table text} $::rcsettings::ui::form::Notes {
        if {![dict exists $::rcsettings::ui::form::Layout $table]} {
            lappend stale $table
        }
    }
    set stale
} -result {}

test layout-2.1 {each row's widget matches the type of the key it writes} -constraints {
    tk realBinary
} -body {
    # The model formats an edited value after the type of the schema's default,
    # so a checkbutton on a float key would write 1 into a key the terminal
    # reads as a fraction. The kinds and the TOML types have to agree. A
    # `bool` row with a two-element arg is the one exception: it writes a
    # string enum of two names, not a TOML boolean, which is what the arg
    # itself tells apart from the plain 1/0 checkbutton.
    set want {frac float scale float int int bool bool color string enum string \
        font string choice int}
    set wrong {}
    foreach row [layout_rows] {
        lassign $row table key kind arg
        set type [::tomledit::type_of \
            [::rcsettings::model::shipped $table $key]]
        set expect [expr {
            $kind eq "bool" && $arg ne "" ? "string" : [dict get $want $kind]}]
        if {$type ne $expect} {
            lappend wrong "$table.$key is $type, drawn as $kind"
        }
    }
    set wrong
} -result {}

test layout-2.2 {every picker row has a value list, every colour row a colour} -constraints {
    tk realBinary
} -body {
    set wrong {}
    foreach row [layout_rows] {
        lassign $row table key kind arg
        set value [::tomledit::plain \
            [::rcsettings::model::shipped $table $key]]
        switch -exact -- $kind {
            choice {
                # The row carries the list, so the row is what has to hold
                # the default: a picker whose current value is not among its
                # own entries shows an empty box on open.
                if {$arg eq ""} {
                    lappend wrong "$table.$key has no values on its row"
                } elseif {$value ni $arg} {
                    lappend wrong "$table.$key defaults outside its own list"
                }
            }
            enum {
                if {$key ni [::rcsettings::model::enum_names]} {
                    lappend wrong "$table.$key has no \[values\] list"
                } elseif {$value ni [::rcsettings::model::enum $key]} {
                    lappend wrong "$table.$key defaults outside its own list"
                }
            }
            color {
                if {![regexp {^#[0-9a-fA-F]{6}$} $value]} {
                    lappend wrong "$table.$key defaults to $value"
                }
            }
            font {
                set catalogue [lmap f [::rcsettings::model::fonts] \
                    {lindex $f 0}]
                if {$value ni $catalogue} {
                    lappend wrong "$table.$key defaults to an uncatalogued face"
                }
            }
        }
    }
    set wrong
} -result {}

# The SSH tab is a list editor, so what it has to cover is not a table of
# keys but a row's fields and the two keys of `[ssh]` itself. `default` is
# the radio down the left of the list, and `host` is the list.
set ::sshcontrols {default {the radio} host {the rows themselves}}

proc ssh_field_keys {} {
    set out {}
    foreach {key label width} $::rcsettings::ui::ssh_page::Fields {
        lappend out $key
    }
    return $out
}

test ssh-layout-1.1 {every field of an ssh row has a box on the tab} -constraints {
    tk realBinary
} -body {
    set missing {}
    set shown [ssh_field_keys]
    foreach key [::rcsettings::model::table_keys ssh_host_defaults] {
        if {$key ni $shown} { lappend missing $key }
    }
    set missing
} -result {}

test ssh-layout-1.2 {no box names a field a row does not have} -constraints {
    tk realBinary
} -body {
    set unknown {}
    foreach key [ssh_field_keys] {
        if {![::rcsettings::model::has_default ssh_host_defaults $key]} {
            lappend unknown $key
        }
    }
    set unknown
} -result {}

test ssh-layout-1.3 {every key of the ssh table has a control} -constraints {
    tk realBinary
} -body {
    # A third key added to `[ssh]` would be invisible in this window and
    # reachable only by hand-editing, which is what this test is here to
    # stop. Naming it in ::sshcontrols is what deciding costs.
    set loose {}
    foreach key [::rcsettings::model::table_keys ssh] {
        if {![dict exists $::sshcontrols $key]} { lappend loose $key }
    }
    dict for {key what} $::sshcontrols {
        if {![::rcsettings::model::has_default ssh $key]} {
            lappend loose "$key ($what) is no longer a key"
        }
    }
    set loose
} -result {}

test ssh-layout-2.1 {a port box writes what the schema types as an integer} -constraints {
    tk realBinary
} -body {
    # The model formats a field after the type of its row default, so a box
    # that took anything but digits for `port` would write a string into a
    # key the terminal reads as a number.
    set wrong {}
    foreach {key type} {host string user string port int key string} {
        set was [::tomledit::type_of \
            [::rcsettings::model::shipped ssh_host_defaults $key]]
        if {$was ne $type} { lappend wrong "$key is $was, edited as $type" }
    }
    set wrong
} -result {}

test ssh-layout-2.2 {the checked row is worked out from the host strings} -constraints {
    tk realBinary
} -body {
    # Positions are not what `default` names, so two rows sharing a host
    # check the first and a name no row answers to checks localhost.
    set rows {{host a} {host b} {host b}}
    list [::rcsettings::ui::ssh_page::checked $rows ""] \
        [::rcsettings::ui::ssh_page::checked $rows b] \
        [::rcsettings::ui::ssh_page::checked $rows gone]
} -result {-1 1 -1}

test colour-1.1 {a colour is narrowed to the file's three bytes} -constraints {
    tk realBinary
} -body {
    # tk_chooseColor answers in the display's own width, which is 16 bits a
    # channel on X11. What goes in the file is what the file's colours are.
    join [list [::rcsettings::ui::form::hex "#33ff66"] \
        [::rcsettings::ui::form::hex "#3333ffff6666"] \
        [::rcsettings::ui::form::hex "#000"]] " "
} -result {#33ff66 #33ff66 #000000}

# ------------------------------------------ font_source and its fetch --
#
# screen.font_source draws as a checkbutton, the bool kind's arg carrying
# {system_fonts bundled_fonts} instead of the default 1/0, because the key
# it writes is a two-name string enum, not a TOML boolean. What has to
# hold: the row renders and writes through the same set_value path every
# other row uses, and the lazy fetch it gates fires exactly when the docs
# say it should - not before the box is checked, not on a tab whose
# pickers do not read the list, and never a second time.
#
# The exec itself is not run here: what these tests are about is the
# gating around the call, not the call. So ::rcsettings::model::
# system_fonts is swapped for a stub for the length of one body, the same
# shape force_test_binary gives the model's own exec.
proc with_stub_system_fonts {pairs script} {
    rename ::rcsettings::model::system_fonts ::rcsettings::model::system_fonts_real
    proc ::rcsettings::model::system_fonts {{path ""}} [list return $pairs]
    set code [catch {uplevel 1 $script} result opts]
    rename ::rcsettings::model::system_fonts {}
    rename ::rcsettings::model::system_fonts_real ::rcsettings::model::system_fonts
    return -options $opts $result
}

if {[testConstraint tk]} {
    set ::sfdir [file join [temporaryDirectory] ui-sysfonts-[pid]]
    set ::sfpath [file join $::sfdir config.toml]
}

proc sf_init {text} {
    file mkdir $::sfdir
    ::tomledit::atomic_write $::sfpath $text
    ::rcsettings::model::init $::sfpath
}

# The three module variables the fetch is gated on and remembers into,
# put back to their fresh-window state so one test's fetch cannot answer
# for the next.
proc sf_reset_state {} {
    set ::rcsettings::ui::form::SystemFonts {}
    set ::rcsettings::ui::form::SystemFontsFetched 0
    set ::rcsettings::ui::form::SystemFontsFetching 0
}

test fontsource-6.1 {the row renders the effective string, unquoted} -constraints {
    tk realBinary
} -body {
    sf_init "\[screen\]\n"
    sf_reset_state
    toplevel .t61
    wm withdraw .t61
    ::rcsettings::ui::form::page .t61 screen
    set v $::rcsettings::ui::form::Value(screen.font_source)
    destroy .t61
    set v
} -result bundled_fonts

test fontsource-6.2 {a pinned system_fonts value renders checked} -constraints {
    tk realBinary
} -body {
    sf_init "\[screen\]\nfont_source = \"system_fonts\"\n"
    sf_reset_state
    toplevel .t62
    wm withdraw .t62
    ::rcsettings::ui::form::page .t62 screen
    set v $::rcsettings::ui::form::Value(screen.font_source)
    destroy .t62
    set v
} -result system_fonts

test fontsource-6.3 {toggling it writes system_fonts through set_value} -constraints {
    tk realBinary
} -body {
    sf_init "\[screen\]\n"
    sf_reset_state
    toplevel .t63
    wm withdraw .t63
    ::rcsettings::ui::form::page .t63 screen
    set ::rcsettings::ui::form::Value(screen.font_source) system_fonts
    with_stub_system_fonts {} {
        ::rcsettings::ui::form::on_toggle screen.font_source
    }
    set pinned [::rcsettings::model::pinned screen font_source]
    set eff [::rcsettings::model::effective screen font_source]
    destroy .t63
    list $pinned $eff
} -result {1 system_fonts}

test fontsource-6.4 {toggling back off removes the key, the minimal edit} -constraints {
    tk realBinary
} -body {
    sf_init "\[screen\]\nfont_source = \"system_fonts\"\n"
    sf_reset_state
    toplevel .t64
    wm withdraw .t64
    ::rcsettings::ui::form::page .t64 screen
    set ::rcsettings::ui::form::Value(screen.font_source) bundled_fonts
    ::rcsettings::ui::form::on_toggle screen.font_source
    set pinned [::rcsettings::model::pinned screen font_source]
    destroy .t64
    set pinned
} -result 0

# update_font_combos reaches into the Rows the last-built Screen and Chassis
# pages registered, font_name and bank_font_name among them, so a fetch that
# actually runs needs live pages behind those two rows to write back into.
proc sf_build_pages {name} {
    toplevel $name
    wm withdraw $name
    ::rcsettings::ui::form::page $name screen
    ::rcsettings::ui::form::page $name chassis
}

test fetch-7.1 {no fetch while the box reads bundled_fonts} -constraints {
    tk realBinary
} -body {
    sf_init "\[screen\]\n"
    sf_reset_state
    sf_build_pages .t71
    with_stub_system_fonts {{Stub Stub 32 false}} {
        ::rcsettings::ui::form::maybe_fetch_system_fonts screen
    }
    set fetched $::rcsettings::ui::form::SystemFontsFetched
    destroy .t71
    set fetched
} -result 0

test fetch-7.2 {no fetch on a tab whose pickers do not read the list} -constraints {
    tk realBinary
} -body {
    sf_init "\[screen\]\nfont_source = \"system_fonts\"\n"
    sf_reset_state
    sf_build_pages .t72
    with_stub_system_fonts {{Stub Stub 32 false}} {
        ::rcsettings::ui::form::maybe_fetch_system_fonts general
    }
    set fetched $::rcsettings::ui::form::SystemFontsFetched
    destroy .t72
    set fetched
} -result 0

test fetch-7.3 {checked and on Screen or Chassis fetches, once} -constraints {
    tk realBinary
} -body {
    sf_init "\[screen\]\nfont_source = \"system_fonts\"\n"
    sf_reset_state
    sf_build_pages .t73
    with_stub_system_fonts {{Stub {The Stub} 32 false}} {
        ::rcsettings::ui::form::maybe_fetch_system_fonts chassis
    }
    set first [list $::rcsettings::ui::form::SystemFontsFetched \
        $::rcsettings::ui::form::SystemFonts]
    # A later visit, even with a different stub answer, must not refetch.
    with_stub_system_fonts {{Other {Other Face} 32 false}} {
        ::rcsettings::ui::form::maybe_fetch_system_fonts screen
    }
    set second [list $::rcsettings::ui::form::SystemFontsFetched \
        $::rcsettings::ui::form::SystemFonts]
    destroy .t73
    list $first $second
} -result {{1 {{Stub {The Stub} 32 false}}} {1 {{Stub {The Stub} 32 false}}}}

test fetch-7.4 {an error surfaces and resets the guard for a later retry} -constraints {
    tk realBinary
} -body {
    sf_init "\[screen\]\nfont_source = \"system_fonts\"\n"
    sf_reset_state
    sf_build_pages .t74
    rename ::rcsettings::model::system_fonts ::rcsettings::model::system_fonts_real
    proc ::rcsettings::model::system_fonts {{path ""}} { error "no fonts for you" }
    ::rcsettings::ui::form::maybe_fetch_system_fonts screen
    set after1 [list $::rcsettings::ui::form::SystemFontsFetched \
        $::rcsettings::ui::form::SystemFontsFetching]
    rename ::rcsettings::model::system_fonts {}
    rename ::rcsettings::model::system_fonts_real ::rcsettings::model::system_fonts
    with_stub_system_fonts {{Stub Stub 32 false}} {
        ::rcsettings::ui::form::maybe_fetch_system_fonts screen
    }
    set after2 [list $::rcsettings::ui::form::SystemFontsFetched \
        $::rcsettings::ui::form::SystemFonts]
    destroy .t74
    list $after1 $after2
} -result {{0 0} {1 {{Stub Stub 32 false}}}}

test fetch-7.5 {a fetch that lands updates both font combos' values} -constraints {
    tk realBinary
} -body {
    sf_init "\[screen\]\nfont_source = \"system_fonts\"\n"
    sf_reset_state
    sf_build_pages .t75
    with_stub_system_fonts {{SysFace {A System Face} 32 false}} {
        ::rcsettings::ui::form::maybe_fetch_system_fonts screen
    }
    set screen_values [.t75.page_screen.canvas.body.g3.ctl_font_name cget -values]
    set chassis_values [.t75.page_chassis.canvas.body.g1.ctl_bank_font_name cget -values]
    destroy .t75
    list [expr {"A System Face" in $screen_values}] \
        [expr {"A System Face" in $chassis_values}]
} -result {1 1}

proc pick_face {text} {
    set row [dict get $::rcsettings::ui::form::Rows screen.font_name]
    set key [lindex [lsearch -inline -index 1 [::rcsettings::model::fonts] $text] 0]
    [dict get $row control] current [lsearch -exact [dict get $row names] $key]
    ::rcsettings::ui::form::on_pick screen.font_name
    [dict get $::rcsettings::ui::form::Rows general.font_size readout] cget -text
}

test size-8.1 {the readout states what the chosen face draws} -constraints {tk realBinary} -body {
    sf_init "\[general\]\nfont_size = 24\n"
    sf_reset_state
    sf_build_pages .t81
    lmap f {Terminess {Fixedsys Excelsior} Hack} { pick_face $f }
} -cleanup {destroy .t81} -result {{24 px (12 × 2)} {32 px (16 × 2)} {24 px}}

test size-8.2 {a note row is one spanning label with no reset} -constraints {tk realBinary} -body {
    sf_init "\[screen\]\n"
    sf_reset_state
    sf_build_pages .t82
    set slaves [grid slaves .t82.page_screen.canvas.body.g3 -row 6]
    list [llength $slaves] [dict get [grid info $slaves] -columnspan]
} -cleanup {destroy .t82} -result {1 5}

if {[testConstraint tk]} {
    file delete -force $::sfdir
}

cleanupTests
