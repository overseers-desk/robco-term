# The seam between this window and the terminal it asks. The schema is
# the terminal's to state and the window holds no copy of it, so what is
# left to test here is the ask itself: that a real binary's
# --dump-settings comes back and lands in the shapes the model reads it
# out of. Every other suite runs the same ask through init, which is why
# they carry the same constraint.
#
# The system-fonts fetch sits here too: same binary, its own flag, asked
# when the user reaches the font tab rather than at open.

package require tcltest 2.5
namespace import ::tcltest::*

source [file join [file dirname [info script]] helpers.tcl]
source [file join $::libdir model.tcl]
need_binary

test schema-1.1 {the terminal's own dump is what the model reads} -constraints realBinary -body {
    ::rcsettings::model::load_schema
    list [expr {[llength [::rcsettings::model::table_keys general]] > 0}] \
        [expr {[llength [::rcsettings::model::preset_names screen]] > 0}]
} -result {1 1}

# ------------------------------------------------- the system-fonts seam --

test fonts-2.1 {a fonts document parses to name and label pairs} -body {
    ::rcsettings::model::system_fonts_text \
        "\[\[fonts\]\]\nname = \"Hack\"\ntext = \"Hack\"\npixel_size = 32\nlow_resolution = false\n\n\[\[fonts\]\]\nname = 'DejaVu \"Sans\" Mono'\ntext = \"DejaVu Sans Mono\"\npixel_size = 32\nlow_resolution = false\n"
} -result {{Hack Hack 32 false} {{DejaVu "Sans" Mono} {DejaVu Sans Mono} 32 false}}

test fonts-2.2 {a machine with nothing installed is an empty list, not an error} -body {
    ::rcsettings::model::system_fonts_text ""
} -result {}

test fonts-2.3 {the real binary's font walk answers} -constraints realBinary -body {
    # An empty machine is legal; the assertion is that the exec and the
    # parse hold together, not that fonts exist.
    expr {[llength [::rcsettings::model::system_fonts $::binpath]] >= 0}
} -result 1

test locate-3.0 {the sibling is looked for under the platform's own name} -body {
    # Windows resolves an executable by extension; looking for the bare
    # name there is how the sibling arm once silently never matched.
    set tail [file tail [lindex [::rcsettings::model::candidates] end-1]]
    expr {$::tcl_platform(platform) eq "windows"
          ? $tail eq "robco-term.exe" : $tail eq "robco-term"}
} -result 1

test locate-3.2 {the test hook, then the embedded terminal, lead them all} -body {
    set was $::rcsettings::model::ForcedBinary
    set ::rcsettings::model::ForcedBinary [file join / forced robco-term]
    set ::rcsettings::embedded(terminal) [file join / myself robco-term]
    set order [::rcsettings::model::candidates]
    set ::rcsettings::model::ForcedBinary $was
    unset ::rcsettings::embedded(terminal)
    list [lindex $order 0] [lindex $order 1]
} -result [list [file join / forced robco-term] [file join / myself robco-term]]

test locate-3.3 {not finding the binary names every place it was not} -body {
    # The message is the user's whole diagnostic; each arm it names must
    # be an arm candidates actually walks, the sibling with the
    # platform's own suffix.
    set msg [::rcsettings::model::describe_search]
    set sibling "robco-term[::rcsettings::model::exe_suffix]"
    list [string match "*ROBCO_SETTINGS_TERMINAL*" $msg] \
        [string match "*beside this program ($sibling)*" $msg] \
        [string match "*PATH*" $msg]
} -result {1 1 1}

test locate-3.1 {the spawner's own name leads a hand launch's guesses} -body {
    set saved [array get ::env ROBCO_SETTINGS_TERMINAL]
    set ::env(ROBCO_SETTINGS_TERMINAL) [file join / spawner robco-term]
    set was $::rcsettings::model::ForcedBinary
    set ::rcsettings::model::ForcedBinary ""
    set order [::rcsettings::model::candidates]
    set ::rcsettings::model::ForcedBinary $was
    unset ::env(ROBCO_SETTINGS_TERMINAL)
    array set ::env $saved
    # The env arm sits ahead of the sibling and PATH arms.
    expr {[lindex $order 0] eq [file join / spawner robco-term]
          || [lindex $order 1] eq [file join / spawner robco-term]}
} -result 1

::tcltest::cleanupTests
