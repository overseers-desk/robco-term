#!/usr/bin/env tclsh9.0
# robco-settings: the settings window for RobCo Terminal.
#
# A separate executable rather than a mode of the terminal, so the terminal
# needs no GUI toolkit of its own: the terminal spawns this on right-click,
# every change lands in config.toml through the machine-write contract
# (docs/config-format.md), and the terminal's own file watch carries it to
# the glass. There is no IPC.
#
# Boot shape follows questlog: Tcl-only libraries first, Tk enters the
# process with the first ui/ source, never here.

package require Tcl 9

set ROBCO_SETTINGS_VERSION 0.1.7
set ROOT [file dirname [file normalize [info script]]]

foreach lib {diag.tcl tomledit-1.1a1.tm model.tcl} {
    source [file join $ROOT lib $lib]
}

# An error nobody catches has to reach the user somehow, and on Windows the
# shipped image has no console to print it to: started from Explorer it would
# otherwise appear to do nothing at all. Every uncaught background error is
# recorded, and the one failure the whole window rests on - starting - is
# caught here rather than left to the interpreter's own report.
proc bgerror {message} {
    ::rcsettings::diag::record bgerror $message
}

if {[lsearch -exact $argv --version] >= 0 || [lsearch -exact $argv -v] >= 0} {
    puts "robco-settings $ROBCO_SETTINGS_VERSION"
    exit 0
}

foreach ui {form.tcl ssh_page.tcl preset_dialog.tcl app.tcl} {
    source [file join $ROOT ui $ui]
}

if {[catch {::rcsettings::ui::app::start} err]} {
    ::rcsettings::diag::fatal "The settings window could not start." $err
}
